    "hono": "^4.9.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
