{
  "name": "@kesoku/relay",
  "version": "0.1.30",
  "private": true,
  "type": "module",
  "description": "Kesoku Cloud Run relay: stateless auth + in-memory two-leg WebSocket bridge + static PWA + signed media URLs.",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
