{
  "name": "@kesoku/protocol",
  "version": "0.1.26",
  "private": true,
  "type": "module",
  "description": "Kesoku wire protocol V1.2: zod schemas + TypeScript types for the WS envelope and every event.",
  "exports": {
    ".": "./src/index.ts"
