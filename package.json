{
  "name": "kesoku-app",
  "private": true,
  "version": "0.1.31",
  "description": "Kesoku — 4-platform client (Web PWA / Android / iOS) and Cloud Run relay for the self-hosted Kesoku Engine.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm --filter @kesoku/client run build && pnpm --filter @kesoku/relay run build",
    "dev:client": "pnpm --filter @kesoku/client dev",
    "dev:relay": "pnpm --filter @kesoku/relay dev",
    "gen:schema": "pnpm --filter @kesoku/protocol run gen:schema",
    "check:native": "node scripts/check-native-deps.mjs",
    "check:terms": "node scripts/check-terms.mjs",
    "env:check": "./scripts/dev-env.sh sh -c 'command -v node pnpm'",
    "build:apk": "bash scripts/build-android.sh"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
